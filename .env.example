# Copia este archivo a .env y completa los valores. .env nunca se versiona.
DB_TYPE=com.zaxxer.hikari.HikariDataSource
DB_URL=jdbc:postgresql://localhost:5432/cms_mexico
DB_USERNAME=postgres
DB_PASSWORD=
SERVER_PORT=8085

# Core bancario: simulated (por defecto) o fineract
CORE_MODE=simulated
FINERACT_BASE_URL=https://corebancario.alocashfintech.com:4433/fineract-provider/api/v1
FINERACT_TENANT=default
FINERACT_USER=
FINERACT_PASSWORD=

# HSM (PayShieldSim)
HSM_BASE_URL=http://localhost:8080

# Llave del bureau de personalizacion (AES-256, base64). La de application.properties es solo de desarrollo.
PLASTICS_MANUFACTURER_KEY=

# Conexion antifraude de industria (gremio). Ver docs/guild-antifraude.md
GUILD_MODE=simulated
GUILD_PARTICIPANT_ID=CMS-MX-DEV
GUILD_BASE_URL=
GUILD_API_KEY=
GUILD_HMAC_SECRET=
GUILD_SSL_BUNDLE=

# Seguridad de la consola y la API
SECURITY_ENABLED=true
IAM_BASE_URL=http://localhost:4003/api/v1
IAM_PROJECT_CODE=EMISION_CMS
CMS_API_KEY=
CMS_API_KEY_NAME=system

# HSM (comandos de host), boveda de PAN, canal ISO 8583 y stand-in
HSM_HOST=localhost
HSM_PORT=1500
HSM_KEY_PVK=
HSM_KEY_CVK_A=
HSM_KEY_CVK_B=
HSM_KEY_IMK=
HSM_KEY_ZPK=
PAN_ENCRYPTION_KEY=
PAN_HMAC_KEY=
ISO_PORT=8583
STANDIN_MAX_AMOUNT=2000
